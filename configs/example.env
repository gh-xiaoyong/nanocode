# nanocode model configuration

# Required
NANOCODE_API_KEY=your_api_key_here
NANOCODE_MODEL=gpt-4.1

# Optional
NANOCODE_BASE_URL=https://api.openai.com/v1
NANOCODE_TEMPERATURE=0.2
NANOCODE_MAX_TOKENS=4096

# Alternative compatible names supported by the current loader:
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TEMPERATURE=0.2
# OPENAI_MAX_TOKENS=4096
